{
  "hosting": [
    {
      "target": "Dashboard",
      "public": "Dashboard/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        },
        {
          "source": "/foo{,/**}",
          "destination": "/index.html"
        },
        {
          "source": "!/@(js|css)/**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}